        },
        {
            "type": "paragraph",
            "content": {
                "paragraph_content": [
                    {
                        "type": "text",
                        "content": "The whole seakeeping code is arranged in the following folders:"
                    }
                ]
            },
            "bbox": [
                119,
                851,
                631,
                866
            ]
        }
    ],
