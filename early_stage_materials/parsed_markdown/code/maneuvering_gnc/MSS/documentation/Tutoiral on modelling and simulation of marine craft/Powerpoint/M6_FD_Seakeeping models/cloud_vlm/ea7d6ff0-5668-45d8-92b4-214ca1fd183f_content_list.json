    },
    {
        "type": "text",
        "text": "06/06/26",
        "page_idx": 0
    },
    {
        "type": "text",
        "text": "One-day Tutorial, CAMS'07, Bol, Croatia",
        "page_idx": 0
    },
    {
        "type": "text",
