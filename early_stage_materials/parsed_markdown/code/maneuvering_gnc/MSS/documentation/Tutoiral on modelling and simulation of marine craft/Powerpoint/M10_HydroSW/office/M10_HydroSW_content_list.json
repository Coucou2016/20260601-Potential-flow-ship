    },
    {
        "type": "text",
        "text": "Data Processing – Table of Offsets",
        "text_level": 2,
        "page_idx": 5
    },
    {
        "type": "image",
        "img_path": "images/c1a90a464e515d52d27454e18b7303e89b1af0f738658c4f3c60b92834e8ce65.jpg",
        "image_caption": [],
