        "page_idx": 9
    },
    {
        "type": "text",
        "text": "Kinematic transformations {s}-{b}",
        "text_level": 2,
        "page_idx": 10
    },
    {
        "type": "text",
        "text": "The angular velocities are related by",
        "page_idx": 10
    },
    {
        "type": "text",
        "text": "$\\Leftrightarrow$",
        "page_idx": 10
    },
    {
        "type": "text",
        "text": "In {b}",
        "page_idx": 10
    },
    {
        "type": "text",
        "text": "Combining results",
        "page_idx": 10
    },
    {
        "type": "text",
        "text": "06/06/26",
        "page_idx": 10
    },
    {
        "type": "text",
        "text": "One-day Tutorial, CAMS'07, Bol, Croatia",
        "page_idx": 10
    },
