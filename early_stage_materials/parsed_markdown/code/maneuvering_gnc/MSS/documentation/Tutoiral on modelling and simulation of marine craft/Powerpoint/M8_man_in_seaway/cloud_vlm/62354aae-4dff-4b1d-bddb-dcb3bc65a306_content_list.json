        "page_idx": 8
    },
    {
        "type": "text",
        "text": "Kinematic transformations {s}-{b}",
        "text_level": 2,
        "page_idx": 9
    },
    {
        "type": "text",
        "text": "Let",
        "page_idx": 9
    },
    {
        "type": "text",
        "text": "Then",
        "page_idx": 9
    },
    {
        "type": "text",
        "text": "06/06/26",
        "page_idx": 9
    },
    {
        "type": "text",
        "text": "One-day Tutorial, CAMS'07, Bol, Croatia",
