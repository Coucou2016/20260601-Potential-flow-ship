    },
    {
        "type": "text",
        "text": "**Mathematical**",
        "page_idx": 5
    },
    {
        "type": "text",
        "text": "**Models**",
        "page_idx": 5
    },
    {
        "type": "text",
        "text": "(Simulation,GNC-design",
        "page_idx": 5
    },
    {
        "type": "text",
        "text": "HIL-testing, Diagnosis)",
