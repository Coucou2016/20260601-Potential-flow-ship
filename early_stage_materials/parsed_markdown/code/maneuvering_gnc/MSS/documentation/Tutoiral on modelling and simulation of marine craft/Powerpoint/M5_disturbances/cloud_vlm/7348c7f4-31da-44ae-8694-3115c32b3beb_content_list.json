        "page_idx": 15
    },
    {
        "type": "text",
        "text": "Statistics of Maxima",
        "text_level": 2,
        "page_idx": 16
    },
    {
        "type": "image",
        "img_path": "images/7d7a61766478051d621a632e57f74d88c835f0d4abab606dfd831686511ca23e.jpg",
        "image_caption": [],
        "page_idx": 16
    },
    {
