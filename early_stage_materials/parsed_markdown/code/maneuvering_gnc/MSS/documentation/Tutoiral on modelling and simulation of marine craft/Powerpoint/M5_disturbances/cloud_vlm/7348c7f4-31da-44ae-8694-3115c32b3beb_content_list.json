        "page_idx": 13
    },
    {
        "type": "text",
        "text": "Example narrow and wide-banded",
        "text_level": 2,
        "page_idx": 14
    },
    {
        "type": "text",
        "text": "Narrow-banded signal",
        "page_idx": 14
    },
    {
        "type": "text",
        "text": "Wide-banded signal",
        "page_idx": 14
    },
    {
