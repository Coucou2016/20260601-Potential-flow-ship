    # 
    # Enter the mapping builder
    # 
    builder
    # 
    # ------------------------------------------------------------------------------------------------------------
    # 
    # Surface grid bow top
    # 
    # ------------------------------------------------------------------------------------------------------------
    # 
    create surface grid
    edge curve tolerance 0.000001
    set view:0 -0.344074 0.157652 0 4.82241 0.5 -0.296198 0.813798 0.866025 0.17101 -0.469846 -9.61481e-17 0.939693 0.34202
    choose edge curve 9 1.107972e+00 5.991485e-11 -1.736756e-01 
    pause
    done
    uniform dissipation 4
    #
    # March the grid in both directions 
    # 
    forward and backward
    lines to march 181 181
    distance to march 0.22 0.22
    points on initial curve 105 
    equidistribution 1
    BC: left (forward) fix z, float x and y
    BC: left (backward) fix z, float x and y
    BC: right (forward) outward splay
    BC: right (backward) outward splay 
    outward splay 0.35 0.35
    # 
    # Generate the grid
    # 
    generate
    lines
    75 171
    pause
    exit
