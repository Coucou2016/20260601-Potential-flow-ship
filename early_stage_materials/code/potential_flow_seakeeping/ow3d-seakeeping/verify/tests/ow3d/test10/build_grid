* this scrpit is used for grid generation of a two-dimensional
* submerged cylinder in a channel.
*
* grid parameters
*
* tank
  $t_left  = -1.5;
  $t_right = 1.5;
  $t_depth = 1.5;
  $t_resolution = 1; $t_lines_horizontal = 20; $t_lines_vertical = 10; 
  $tlh = int($t_resolution*$t_lines_horizontal);
  $tlv = int($t_resolution*$t_lines_vertical);
*
* cylinder
  $c_x = 0; 
  $c_y = 0;
  $c_resolution = 1; $c_lines_radial = 6; $c_lines_circumferential = 10;
  $clr = int($c_resolution*$c_lines_radial);
  $clc = int($c_resolution*$c_lines_circumferential);
  $inner_a = 0.5;
  $outer_a = 1;
*
*
create mappings
       rectangle
       set corners
       $t_left $t_right -$t_depth 0.0
       lines
       $tlh $tlv
       boundary conditions
       4 4 2 1 * periodic=-1, interpolation=0, free=1, impermeable=2, exciting=3, absorbing=4
       share
       0 0 0 1 * free=1
       mappingName
       tank
       exit
        annulus
    	centre
	$c_x $c_y
    	inner and outer radii
      	$inner_a $outer_a
    	start and end angles 
      	0.5 1.0
    	lines
     	$clc $clr
    	boundary conditions
      	1 1 3 0	
    	share
      	1 1 0 0
   	 mappingName
      	 semicircle
  exit
*
* stretching
	stretch coordinates
	transform which mapping?
	semicircle
	stretch
	specify stretching along axis=1
	layers
	1
	2 2 0
	exit
	exit
	mappingName
        stretchedSemicircle
	exit
	stretch coordinates
	transform which mapping?
	tank
	stretch
	specify stretching along axis=0
	layers
	1
	10 10 0.5
	*1 1 0.5
	exit
	specify stretching along axis=1
	layers
	1
	2 3 1
	exit
	exit
	mappingName
	stretchedTank
	exit
