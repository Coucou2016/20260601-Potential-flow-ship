*
* this scrpit is used for grid generation of a two-dimensional
* submerged cylinder in a channel.
*
* grid parameters
*
* tank
  $t_left  = -15;
  $t_right = 15;
  $t_depth = 5;
  $t_resolution = 0.35; $t_lines_horizontal = 350; $t_lines_vertical = 100; 
  $tlh = int($t_resolution*$t_lines_horizontal);
  $tlv = int($t_resolution*$t_lines_vertical);
*
* cylinder
  $c_x = 0; 
  $c_y = -1;
  $c_resolution = 0.35; $c_lines_radial = 20; $c_lines_circumferential = 100;
  $clr = int($c_resolution*$c_lines_radial);
  $clc = int($c_resolution*$c_lines_circumferential);
  $inner_a = 0.5;
  $outer_a = 0.75;
*
*
create mappings
	rectangle
       	set corners
       	$t_left $t_right -$t_depth 0.0
       	lines
       	$tlh $tlv
       	boundary conditions
       	4 4 2 1 * periodic=-1, interpolation=0, free=1, impermeable=2, exciting=3, absorbing=4
       	mappingName
       	tank
       	exit
       	annulus
       	centre
       	$c_x $c_y
       	inner and outer radii
       	$inner_a $outer_a
       	lines
       	$clc $clr
       	boundary conditions
       	-1 -1 3 0
       	mappingName
       	cylinder	
       	exit
*
* stretching
*
	stretch coordinates
	transform which mapping?
	cylinder
	stretch
	specify stretching along axis=1
	layers
	1
 	5 2 0
      	exit
      	exit
      	mappingName
      	stretchedCylinder
      	exit
      	stretch coordinates
     	transform which mapping?
     	tank
      	stretch
      	specify stretching along axis=0
      	layers
      	1
      	15 10 0.5
      	exit
	specify stretching along axis=1
	layers
	1
	15 3 1
	exit
      	exit
      	mappingName
      	stretchedTank
      	exit
*
* View mappings.
*
	view mappings
    	stretchedTank
    	stretchedCylinder
    	colour boundaries by boundary condition number
    	colour boundaries by share value
    	erase and exit
exit
*
* Generate an overlapping grid.
*
	generate an overlapping grid
    	stretchedTank
    	stretchedCylinder
    	done
    	change parameters
    	interpolation type
    	implicit for all grids
    	ghost points
    	all
    	2 2 2 2 * number of ghost points
   	*1 1 1 1 
    	order of accuracy
    	fourth order
	exit
*
compute overlap
	exit
*
save an overlapping grid
    	test_grid.hdf
    	exit
	exit
